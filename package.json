{
  "name": "@sqnb/dsh-skill-manager",
  "version": "0.1.0",
  "description": "Skill path and enablement manager for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./policy": "./lib/policy.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/policy.js", "cordis.patch.yml", "README.md", "test"],
  "license": "MIT",
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale"],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  }
}
